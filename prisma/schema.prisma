generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SHOP
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK_TRANSFER
  MIXED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGE
  EXPIRY
  THEFT
  STOCK_COUNT
  MANUAL_ADJUSTMENT
  OFFLINE_RECONCILIATION
}

enum InventoryAlertType {
  LOW_STOCK
  CRITICAL_STOCK
  OUT_OF_STOCK
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationType {
  LOW_STOCK
  CRITICAL_STOCK
  OUT_OF_STOCK
  WEEKLY_REPORT
  REFUND_REQUEST
  REGISTER_DISCREPANCY
  SYNC_CONFLICT
  STOCK_TRANSFER
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SyncBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ConflictType {
  INSUFFICIENT_SERVER_STOCK
  PRODUCT_DEACTIVATED
  PRICE_CHANGED
  REGISTER_CLOSED
  INVALID_SHOP_SESSION
  DUPLICATE_MUTATION
}

enum ConflictStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Business {
  id                     String   @id @default(cuid())
  name                   String
  code                   String   @unique
  email                  String?
  phone                  String?
  address                String?  @db.Text
  taxPin                 String?
  currency               String   @default("KES")
  timezone               String   @default("Africa/Nairobi")
  logoUrl                String?
  receiptFooter          String?  @db.Text
  defaultReorderLevel    Int      @default(10)
  defaultCriticalLevel   Int      @default(5)
  offlineSessionHours    Int      @default(24)
  syncIntervalMinutes    Int      @default(5)
  weeklyReportDay        Int      @default(1)
  weeklyReportHour       Int      @default(8)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shops                  Shop[]
  users                  User[]
  categories             Category[]
  brands                 Brand[]
  units                  Unit[]
  products               Product[]
  inventoryReports       InventoryReport[]
  notificationPreference NotificationPreference?
  expenseCategories      ExpenseCategory[]
}

model Shop {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  code        String   @unique
  email       String?
  phone       String?
  address     String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account          User?
  salespeople      SalespersonProfile[]
  inventory        ShopInventory[]
  sales            Sale[]
  registers        Register[]
  registerSessions RegisterSession[]
  stockMovements   StockMovement[]
  outgoingTransfers StockTransfer[]      @relation("TransferSource")
  incomingTransfers StockTransfer[]      @relation("TransferDestination")
  inventoryAlerts  InventoryAlert[]
  expenses         Expense[]
  devices          OfflineDevice[]
  syncBatches      OfflineSyncBatch[]
  conflicts        OfflineSyncConflict[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  idempotency      IdempotencyRecord[]
  reportItems      InventoryReportItem[]
  refundRequests   RefundRequest[]

  @@index([businessId, isActive])
}

model User {
  id                  String        @id @default(cuid())
  businessId          String
  shopId              String?       @unique
  name                String
  email               String        @unique
  passwordHash        String
  role                UserRole
  status              AccountStatus @default(ACTIVE)
  passwordVersion     Int           @default(1)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shop              Shop?              @relation(fields: [shopId], references: [id])
  createdBy         User?              @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers      User[]             @relation("UserCreatedBy")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([businessId, role, status])
}

model SalespersonProfile {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  pinHash   String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales     Sale[]
  sessions  RegisterSession[]

  @@unique([shopId, code])
  @@index([shopId, isActive])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  slug       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, slug])
}

model Brand {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
}

model Unit {
  id         String   @id @default(cuid())
  businessId String
  name       String
  symbol     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, symbol])
}

model Product {
  id                  String        @id @default(cuid())
  businessId          String
  categoryId          String?
  brandId             String?
  unitId              String?
  name                String
  sku                 String
  barcode             String?
  description         String?       @db.Text
  imageUrl             String?
  defaultCostPrice    Decimal       @db.Decimal(14, 2)
  defaultSellingPrice Decimal       @db.Decimal(14, 2)
  taxRate              Decimal      @default(0) @db.Decimal(5, 2)
  trackStock           Boolean      @default(true)
  status               ProductStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category             Category?     @relation(fields: [categoryId], references: [id])
  brand                Brand?        @relation(fields: [brandId], references: [id])
  unit                 Unit?         @relation(fields: [unitId], references: [id])
  inventory             ShopInventory[]
  saleItems             SaleItem[]
  stockMovements        StockMovement[]
  transferItems         StockTransferItem[]
  inventoryAlerts       InventoryAlert[]
  reportItems           InventoryReportItem[]
  refundItems           RefundItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, status, name])
}

model ShopInventory {
  id                String   @id @default(cuid())
  shopId            String
  productId         String
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  reorderLevel      Int      @default(10)
  criticalLevel     Int      @default(5)
  reorderQuantity   Int      @default(20)
  costPrice         Decimal  @db.Decimal(14, 2)
  sellingPrice      Decimal  @db.Decimal(14, 2)
  isAvailable       Boolean  @default(true)
  shelfLocation     String?
  lastStockedAt     DateTime?
  lastSoldAt        DateTime?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([shopId, quantity])
  @@index([productId])
}

model Register {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sessions  RegisterSession[]

  @@unique([shopId, code])
}

model RegisterSession {
  id                String                @id @default(cuid())
  shopId            String
  registerId        String
  salespersonId     String?
  status            RegisterSessionStatus @default(OPEN)
  openingCash       Decimal               @db.Decimal(14, 2)
  expectedCash      Decimal?              @db.Decimal(14, 2)
  actualCash        Decimal?              @db.Decimal(14, 2)
  variance          Decimal?              @db.Decimal(14, 2)
  openingNote       String?               @db.Text
  closingNote       String?               @db.Text
  openedAt          DateTime              @default(now())
  closedAt          DateTime?
  localReference    String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  register          Register             @relation(fields: [registerId], references: [id], onDelete: Cascade)
  salesperson       SalespersonProfile?  @relation(fields: [salespersonId], references: [id])
  sales             Sale[]
  transactions      RegisterTransaction[]

  @@index([shopId, status])
}

model RegisterTransaction {
  id                String   @id @default(cuid())
  registerSessionId String
  type              String
  amount            Decimal  @db.Decimal(14, 2)
  note              String?  @db.Text
  createdAt         DateTime @default(now())

  registerSession   RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Cascade)

  @@index([registerSessionId, createdAt])
}

model Sale {
  id                String      @id @default(cuid())
  shopId            String
  registerSessionId String?
  salespersonId     String?
  receiptNumber     String      @unique
  clientReference   String?     @unique
  status            SaleStatus  @default(COMPLETED)
  subtotal           Decimal     @db.Decimal(14, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal     @default(0) @db.Decimal(14, 2)
  total              Decimal     @db.Decimal(14, 2)
  amountPaid         Decimal     @db.Decimal(14, 2)
  changeDue          Decimal     @default(0) @db.Decimal(14, 2)
  customerName       String?
  note               String?     @db.Text
  isOffline          Boolean     @default(false)
  occurredAt         DateTime
  syncedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  shop               Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  registerSession    RegisterSession?        @relation(fields: [registerSessionId], references: [id])
  salesperson        SalespersonProfile?     @relation(fields: [salespersonId], references: [id])
  items              SaleItem[]
  payments           Payment[]
  refundRequests     RefundRequest[]
  refunds            Refund[]

  @@index([shopId, occurredAt])
  @@index([salespersonId, occurredAt])
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  productId     String
  productName   String
  sku           String
  quantity      Int
  unitCost      Decimal  @db.Decimal(14, 2)
  unitPrice     Decimal  @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String
  method      PaymentMethod
  status      PaymentStatus @default(VERIFIED)
  amount      Decimal       @db.Decimal(14, 2)
  reference   String?
  createdAt   DateTime      @default(now())

  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, method])
}

model StockMovement {
  id              String            @id @default(cuid())
  shopId          String
  productId       String
  type            StockMovementType
  quantityChange  Int
  quantityBefore  Int
  quantityAfter   Int
  referenceType   String?
  referenceId     String?
  note            String?           @db.Text
  createdAt       DateTime          @default(now())

  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shopId, productId, createdAt])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id                String         @id @default(cuid())
  transferNumber    String         @unique
  sourceShopId      String
  destinationShopId String
  status            TransferStatus @default(DRAFT)
  note              String?        @db.Text
  dispatchedAt      DateTime?
  receivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sourceShop        Shop           @relation("TransferSource", fields: [sourceShopId], references: [id], onDelete: Restrict)
  destinationShop   Shop           @relation("TransferDestination", fields: [destinationShopId], references: [id], onDelete: Restrict)
  items             StockTransferItem[]

  @@index([sourceShopId, status])
  @@index([destinationShopId, status])
}

model StockTransferItem {
  id                 String   @id @default(cuid())
  transferId         String
  productId          String
  requestedQuantity  Int
  dispatchedQuantity Int      @default(0)
  receivedQuantity   Int      @default(0)
  damagedQuantity    Int      @default(0)

  transfer            StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
}

model InventoryAlert {
  id                String             @id @default(cuid())
  shopId            String
  productId         String
  type              InventoryAlertType
  status            AlertStatus        @default(ACTIVE)
  currentQuantity   Int
  thresholdQuantity Int
  firstTriggeredAt  DateTime           @default(now())
  lastTriggeredAt   DateTime           @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, status, type])
  @@index([productId, status])
}

model InventoryReport {
  id                   String       @id @default(cuid())
  businessId           String
  periodStart          DateTime
  periodEnd            DateTime
  status               ReportStatus @default(PENDING)
  totalStockQuantity   Int          @default(0)
  totalCostValue       Decimal      @default(0) @db.Decimal(16, 2)
  totalSellingValue    Decimal      @default(0) @db.Decimal(16, 2)
  lowStockCount        Int          @default(0)
  criticalStockCount   Int          @default(0)
  outOfStockCount      Int          @default(0)
  generatedAt          DateTime?
  errorMessage         String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business             Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items                InventoryReportItem[]

  @@unique([businessId, periodStart, periodEnd])
}

model InventoryReportItem {
  id                     String   @id @default(cuid())
  reportId               String
  shopId                 String
  productId              String
  openingQuantity        Int      @default(0)
  quantityAdded          Int      @default(0)
  quantitySold           Int      @default(0)
  quantityTransferredIn  Int      @default(0)
  quantityTransferredOut Int      @default(0)
  quantityDamaged        Int      @default(0)
  closingQuantity        Int      @default(0)
  reorderLevel           Int
  criticalLevel          Int
  stockStatus            String
  averageDailySales      Decimal  @default(0) @db.Decimal(12, 2)
  estimatedDaysRemaining Decimal? @db.Decimal(12, 2)
  costValue              Decimal  @default(0) @db.Decimal(16, 2)
  sellingValue           Decimal  @default(0) @db.Decimal(16, 2)

  report                  InventoryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  shop                    Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product                 Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([reportId, shopId, productId])
  @@index([shopId, stockStatus])
}

model RefundRequest {
  id          String       @id @default(cuid())
  saleId      String
  shopId      String
  reason      String       @db.Text
  status      RefundStatus @default(PENDING)
  requestedAt DateTime     @default(now())
  reviewedAt  DateTime?
  reviewNote  String?      @db.Text

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, status])
}

model Refund {
  id           String       @id @default(cuid())
  saleId       String
  refundNumber String       @unique
  status       RefundStatus @default(COMPLETED)
  total        Decimal      @db.Decimal(14, 2)
  reason       String       @db.Text
  createdAt    DateTime     @default(now())

  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items        RefundItem[]
}

model RefundItem {
  id        String  @id @default(cuid())
  refundId  String
  productId String
  quantity  Int
  amount    Decimal @db.Decimal(14, 2)
  restock   Boolean @default(true)

  refund    Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@unique([businessId, name])
}

model Expense {
  id          String        @id @default(cuid())
  shopId      String
  categoryId  String
  amount      Decimal       @db.Decimal(14, 2)
  description String        @db.Text
  status      ExpenseStatus @default(PENDING)
  receiptUrl  String?
  occurredAt  DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([shopId, status, occurredAt])
}

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  shopId      String?
  type        NotificationType
  priority    NotificationPriority @default(NORMAL)
  title       String
  message     String               @db.Text
  actionUrl   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop        Shop?                @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([shopId, createdAt])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  lowStockInApp       Boolean  @default(true)
  lowStockPush        Boolean  @default(true)
  lowStockEmail       Boolean  @default(false)
  criticalInApp       Boolean  @default(true)
  criticalPush        Boolean  @default(true)
  criticalEmail       Boolean  @default(true)
  outOfStockInApp     Boolean  @default(true)
  outOfStockPush      Boolean  @default(true)
  outOfStockEmail     Boolean  @default(true)
  weeklyReportInApp   Boolean  @default(true)
  weeklyReportPush    Boolean  @default(true)
  weeklyReportEmail   Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model EmailQueue {
  id              String      @id @default(cuid())
  recipient       String
  subject         String
  htmlBody        String      @db.LongText
  textBody        String?     @db.LongText
  type            String
  status          QueueStatus @default(PENDING)
  attempts        Int         @default(0)
  maximumAttempts Int         @default(3)
  lastError       String?     @db.Text
  scheduledFor    DateTime    @default(now())
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, scheduledFor])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpointHash String   @unique
  endpoint     String   @db.Text
  p256dh       String   @db.Text
  auth         String   @db.Text
  userAgent    String?  @db.Text
  deviceName   String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model PushNotificationQueue {
  id              String      @id @default(cuid())
  userId          String
  title           String
  body            String      @db.Text
  actionUrl       String?
  tag             String?
  status          QueueStatus @default(PENDING)
  attempts        Int         @default(0)
  maximumAttempts Int         @default(3)
  lastError       String?     @db.Text
  scheduledFor    DateTime    @default(now())
  sentAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, scheduledFor])
  @@index([userId])
}

model OfflineDevice {
  id                     String   @id
  shopId                 String
  name                   String
  platform               String?
  userAgent              String?  @db.Text
  isTrusted              Boolean  @default(true)
  isActive               Boolean  @default(true)
  lastSeenAt             DateTime @default(now())
  lastSyncAt             DateTime?
  offlineAccessExpiresAt DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop                   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  syncBatches            OfflineSyncBatch[]
  conflicts              OfflineSyncConflict[]

  @@index([shopId, isActive])
}

model OfflineSyncBatch {
  id            String          @id @default(cuid())
  shopId        String
  deviceId      String
  status        SyncBatchStatus @default(PENDING)
  recordCount   Int             @default(0)
  successCount  Int             @default(0)
  conflictCount Int             @default(0)
  errorCount    Int             @default(0)
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  errorSummary  String?         @db.Text

  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  device        OfflineDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([shopId, startedAt])
}

model OfflineSyncConflict {
  id              String         @id @default(cuid())
  shopId          String
  deviceId        String
  batchId         String?
  type            ConflictType
  status          ConflictStatus @default(OPEN)
  entityType      String
  entityReference String
  details         Json
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?

  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  device          OfflineDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  shopId       String
  operation    String
  responseData Json?
  processedAt  DateTime @default(now())
  expiresAt    DateTime?

  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, processedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  shopId      String?
  action      String
  entityType  String?
  entityId    String?
  description String   @db.Text
  metadata    Json?
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledJobLog {
  id               String   @id @default(cuid())
  jobType          String
  status           String
  recordsProcessed Int      @default(0)
  recordsFailed    Int      @default(0)
  errorSummary     String?  @db.Text
  startedAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([jobType, startedAt])
}
