# Public HTTPS URLs. Do not add mpesa_token yourself; the application adds it when registering or sending callbacks.
MPESA_STK_CALLBACK_URL="https://your-domain.example/api/mpesa/stk/callback"
MPESA_C2B_CONFIRMATION_URL="https://your-domain.example/api/mpesa/c2b/confirmation"
MPESA_C2B_VALIDATION_URL="https://your-domain.example/api/mpesa/c2b/validation"
# Optional, reserved for a future Daraja Transaction Status request flow.
MPESA_STATUS_RESULT_URL="https://your-domain.example/api/mpesa/status/result"
MPESA_STATUS_TIMEOUT_URL="https://your-domain.example/api/mpesa/status/timeout"
# Use a long random value. The application appends it to callback URLs before
# giving them to Safaricom, preventing unauthorised callback requests.
MPESA_CALLBACK_SECRET=""
# Upstash QStash (server-only; retrieve the secrets from the QStash console)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Leave at the default unless Upstash gives you a regional endpoint.
QSTASH_URL="https://qstash.upstash.io"
# Schedule expressions. Daily and weekly reports use Kenya time.
QSTASH_NOTIFICATION_CRON="* * * * *"
QSTASH_SUPPLIER_RESTOCK_CRON="*/15 * * * *"
QSTASH_DAILY_SUMMARY_CRON="CRON_TZ=Africa/Nairobi 0 21 * * *"
QSTASH_WEEKLY_INVENTORY_CRON="CRON_TZ=Africa/Nairobi 0 8 * * 1"
